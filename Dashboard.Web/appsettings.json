{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DashboardModules": {
    "HealthEndpoints": {
      "Display": {
        "ShowOnDashboard": true,
        "PageGroup": null,
        "RefreshMode": "Auto",
        "RefreshIntervalSeconds": 45
      },
      "TimeoutSeconds": 10,
      "Endpoints": []
    },
    "BlobLimits": {
      "Display": {
        "ShowOnDashboard": true,
        "PageGroup": "Storage",
        "RefreshMode": "Manual",
        "RefreshIntervalSeconds": 120
      },
      "Accounts": [
        {
          "Name": "prod-logs-storage",
          "UsedGiB": 740,
          "LimitGiB": 1024,
          "WarningPercent": 80,
          "CriticalPercent": 95
        },
        {
          "Name": "app-data-storage",
          "UsedGiB": 190,
          "LimitGiB": 512,
          "WarningPercent": 75,
          "CriticalPercent": 90
        }
      ]
    },
    "AppInsightsKql": {
      "Display": {
        "ShowOnDashboard": true,
        "PageGroup": "Application Insights",
        "RefreshMode": "Auto",
        "RefreshIntervalSeconds": 300
      },
      "Enabled": false,
      "Title": "InvalidOperationException Watch",
      "AppId": "",
      "ApiKey": "",
      "Query": "exceptions | where type == \"System.InvalidOperationException\" | summarize Count=count()",
      "Timespan": "PT24H",
      "MaxAllowedMatches": 0
    }
  }
}
